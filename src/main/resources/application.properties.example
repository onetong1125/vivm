# Copy to application.properties and fill in your local connection settings.
# application.properties is ignored by Git; never commit credentials.
spring.application.name=vivm
server.port=8081
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.datasource.url=jdbc:mysql://localhost:3306/vivm_db
spring.datasource.username=YOUR_DATABASE_USER
spring.datasource.password=YOUR_DATABASE_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=update

libvirt.uri=qemu+ssh://YOUR_SSH_USER@YOUR_HOST/system?socket=/var/run/libvirt/libvirt-sock
ssh.host=YOUR_HOST
ssh.port=22
ssh.username=YOUR_SSH_USER
ssh.password=YOUR_SSH_PASSWORD
# For key authentication, remove ssh.password and set these as needed:
# ssh.privateKeyPath=/path/to/your/private/key
# ssh.passphrase=YOUR_KEY_PASSPHRASE
ssh.connectionTimeout=30000
ssh.session.keepAliveInterval=60000
